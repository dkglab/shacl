PREFIX lcsh: <http://id.loc.gov/authorities/subjects/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX aat: <http://vocab.getty.edu/aat/>

# Eight Library of Congress Subject Headings, with their real identifiers,
# labels and skos:broader links (id.loc.gov, 16 Nov 2026). LCSH publishes
# skos:narrower too; it's left out here so inference has something to do.
# Most headings have more broader concepts than are shown.

lcsh:sh2010012761 a skos:Concept ;
  skos:prefLabel "Lou (Dog)"@en ;
  skos:broader lcsh:sh85038796 .

lcsh:sh98004876 a skos:Concept ;
  skos:prefLabel "Blind dogs"@en ;
  skos:broader lcsh:sh2006008786 .

lcsh:sh98000776 a skos:Concept ;
  skos:prefLabel "Deaf dogs"@en ;
  skos:broader lcsh:sh2006008786 .

lcsh:sh2006008786 a skos:Concept ;
  skos:prefLabel "Dogs with disabilities"@en ;
  skos:broader lcsh:sh85038796 , lcsh:sh2012002084 .

lcsh:sh2012002084 a skos:Concept ;
  skos:prefLabel "Animals with disabilities"@en .

lcsh:sh85038796 a skos:Concept ;
  skos:prefLabel "Dogs"@en ;
  skos:broader lcsh:sh2008020177 ;
  # Wikidata's "dog" and the Getty Art & Architecture Thesaurus's
  # "Canis familiaris (species)"
  skos:closeMatch wd:Q144 , aat:300250130 .

lcsh:sh2008020177 a skos:Concept ;
  skos:prefLabel "Gray wolf"@en ;
  skos:broader lcsh:sh85147257 .

lcsh:sh85147257 a skos:Concept ;
  skos:prefLabel "Wolves"@en .
