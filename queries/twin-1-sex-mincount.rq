PREFIX ex: <http://example.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# twin: ex:SexShape sh:MinCountConstraintComponent   (11)
SELECT ?this
WHERE {
  ?this rdf:type/rdfs:subClassOf* ex:Dog .
  FILTER NOT EXISTS { ?this ex:sex ?sex }
}
