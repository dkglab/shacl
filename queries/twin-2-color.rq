PREFIX ex: <http://example.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# twin: ex:ColorShape sh:MaxCountConstraintComponent   (4)
# Without DISTINCT each dog comes back twice: (brown, white) and (white, brown).
SELECT DISTINCT ?this
WHERE {
  ?this rdf:type/rdfs:subClassOf* ex:Dog ;
        ex:color ?a , ?b .
  FILTER (?a != ?b)
}
