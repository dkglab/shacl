PREFIX ex: <http://example.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# twin: ex:SexShape sh:InConstraintComponent   (0)
SELECT ?this ?value
WHERE {
  ?this rdf:type/rdfs:subClassOf* ex:Dog ;
        ex:sex ?value .
  FILTER (?value NOT IN (ex:female, ex:male))
}
