# Allemang, Hendler and Gandon, Semantic Web for the Working Ontologist,
# 3rd ed., Figure 7.4 (p. 195), as printed apart from spacing. There is no
# sh:targetClass, so a validator has nothing to check: try it.
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:      <http://www.w3.org/ns/shacl#>
PREFIX account: <http://example.org/account#>

account:Account
  rdf:type sh:NodeShape ;
  rdfs:label "Account" ;
  sh:property [
    rdf:type sh:PropertyShape ;
    sh:path account:lastName ;
    sh:datatype xsd:string ;
    sh:name "family name" ;
    sh:description "the name shared by all members of a family" ;
    sh:maxCount 1 ; sh:minCount 1 ] ;
  sh:property [
    rdf:type sh:PropertyShape ;
    sh:path account:ssn ;
    sh:datatype xsd:string ;
    sh:description "US Social Security Number - format XXX-XX-XXXX" ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "SSN" ;
    sh:pattern "[0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9]" ] ;
  sh:property [
    sh:path account:gender ;
    sh:datatype xsd:string ;
    sh:in ( "female" "male" "other" ) ;
    sh:maxCount 1 ;
    sh:name "gender" ] .
