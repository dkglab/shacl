PREFIX ex: <http://example.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# One shape, three uses (Allemang §7.4). It validates data, as every shape
# does. sh:name and sh:order don't affect validation: they're there for a
# tool that builds a form from the shape. Each constraint suggests a widget:
# a required text box, a date picker, a menu of dogs, two radio buttons.
# The same shape then checks what the form sends back.
ex:DogFormShape a sh:NodeShape ;
  sh:targetClass ex:Dog ;
  sh:property [ sh:path rdfs:label ; sh:name "name" ; sh:order 1 ;
    sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path ex:birthdate ; sh:name "born" ; sh:order 2 ;
    sh:datatype xsd:date ; sh:maxCount 1 ] ;
  sh:property [ sh:path ex:mother ; sh:name "mother" ; sh:order 3 ;
    sh:class ex:Dog ; sh:maxCount 1 ] ;
  sh:property [ sh:path ex:sex ; sh:name "sex" ; sh:order 4 ;
    sh:in ( ex:female ex:male ) ; sh:maxCount 1 ] .
